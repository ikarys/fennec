#!/usr/bin/env bash
# Refuses a commit on develop or main whose subject is not a Conventional
# Commit: release-please reads them to choose the version. Elsewhere anything
# goes, the PR is squashed under its title. Also run by CI on PR titles
# (pr-title.yml, where GitHub sets CI), so the rule lives here only.
set -euo pipefail

if [[ -z ${CI:-} ]]; then
  branch=$(git symbolic-ref --short -q HEAD || true)
  [[ $branch == develop || $branch == main ]] || exit 0
fi

subject=$(head -n1 "$1")
pattern='^(feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'
# Git's own messages: merges, reverts, and the autosquash markers.
generated='^(Merge |Revert "|fixup! |squash! |amend! )'

if [[ ! "$subject" =~ $pattern && ! "$subject" =~ $generated ]]; then
  echo "fennec: not a Conventional Commit: \"$subject\"" >&2
  echo "  expected <type>[(scope)][!]: <description>, type one of" >&2
  echo "  feat fix docs refactor test chore perf build ci style revert" >&2
  exit 1
fi

#!/usr/bin/env bash
# Refuses a commit whose subject is not a Conventional Commit: release-please
# reads them to choose the version. Also run by CI on PR titles (pr-title.yml),
# so the rule lives here only.
set -euo pipefail

subject=$(head -n1 "$1")
pattern='^(feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'
# Git's own messages: merges, reverts, and the autosquash markers.
generated='^(Merge |Revert "|fixup! |squash! |amend! )'

if [[ ! "$subject" =~ $pattern && ! "$subject" =~ $generated ]]; then
  echo "fennec: not a Conventional Commit: \"$subject\"" >&2
  echo "  expected <type>[(scope)][!]: <description>, type one of" >&2
  echo "  feat fix docs refactor test chore perf build ci style revert" >&2
  exit 1
fi
